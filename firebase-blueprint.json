{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product document",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "stock": { "type": "number" },
        "description": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "price", "category", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category document",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug"]
    },
    "PageBlock": {
      "title": "PageBlock",
      "description": "Dynamic homepage block configuration",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 1024 },
        "enabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "enabled"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website and announcement settings",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 128 },
        "announcementText": { "type": "string", "maxLength": 512 },
        "announcementActive": { "type": "boolean" },
        "footerText": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 32 },
        "taxRate": { "type": "number" },
        "shippingFee": { "type": "number" }
      },
      "required": ["siteName"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Uploaded media asset details",
      "type": "object",
      "properties": {
        "filename": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 1024 },
        "alt": { "type": "string", "maxLength": 256 },
        "size": { "type": "string", "maxLength": 32 },
        "dimensions": { "type": "string", "maxLength": 32 },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["filename", "url"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer e-commerce order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "email", "total", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/PageBlock" },
      "description": "Page blocks collection"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global settings collection"
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Media assets collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    }
  }
}
